{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-4-5-20251001"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git commit *)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr view*)",
      "Bash(gh repo *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(pytest *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Write(docs/specs/*)",
      "Write(docs/reviews/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(docker system prune *)",
      "Bash(rm -rf *)"
    ]
  }
}
