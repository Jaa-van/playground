DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-this-to-a-random-32-char-string
VITE_API_URL=/api/v1

# Obsidian Local REST API (선택 — 없으면 동기화 스킵)
# Obsidian → Settings → Community Plugins → Local REST API 에서 확인
OBSIDIAN_API_KEY=your-obsidian-api-key-here
OBSIDIAN_HOST=https://127.0.0.1:27124
OBSIDIAN_VAULT=harness-template
